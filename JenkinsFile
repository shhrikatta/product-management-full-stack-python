pipeline {
    agent none

    environment {
        IMAGE_NAME = "flask-app"
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Code') {
            agent any
            steps {
                git branch: 'develop', url: 'https://github.com/shhrikatta/product-management-full-stack-python'
            }
        }
        stage('Unit Tests') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    args '-u root'
                }
            }
            steps {
                sh '''
                  python -m venv venv
                  . venv/bin/activate
                  pip install --upgrade pip
                  pip install -r requirements.txt
                  pip install pytest pytest-cov
                  pytest --cov=.
                '''
            }
        }
        stage('Build Docker Image') {
            agent any
            steps {
                sh '''
                  docker build -t $IMAGE_NAME:$IMAGE_TAG .
                '''
            }
        }
    }
}